# This file contains placeholders only. Never commit your real .env.
MTA_POLL_SECONDS=15
DISPLAY_REFRESH_SECONDS=5
STALE_AFTER_SECONDS=90
HTTP_TIMEOUT_SECONDS=5
HORIZON_MINUTES=60
DIRECTIONS=N,S
# grouped = four frames, next two trains across the selected lines at each stop/direction.
# routes = twelve frames, next two arrivals for each line/direction (including NO ETA).
DISPLAY_MODE=grouped
ARRIVALS_PER_FRAME=2
# Native Python binds loopback by default. Docker sets HOST=0.0.0.0 internally.
HOST=0.0.0.0
PORT=8080
# Optional auth for /lametric, /api/arrivals, /readyz; not /healthz.
POLL_TOKEN=
# Copy the exact local push URL and app access token from the LaMetric developer portal.
# Example shape: https://192.168.1.50:4343/api/v1/dev/widget/update/<package>/<version>
LAMETRIC_PUSH_URL=
LAMETRIC_ACCESS_TOKEN=
LAMETRIC_VERIFY_TLS=true
# Prefer a trusted device certificate/CA. If the device requires a self-signed cert,
# explicitly set VERIFY_TLS=false only on your trusted LAN, following LaMetric's guide.
LAMETRIC_CA_BUNDLE=
